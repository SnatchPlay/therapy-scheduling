# Скопіюйте у .env.local (він у .gitignore) і заповніть значеннями з вашого проєкту Supabase:
# Project Settings → API Keys (точну назву розділу перевірте в інтерфейсі). Значення ніколи не комітимо й не вставляємо в чат з агентом.

# Публічні (потрапляють у браузер; ці дві й лише ці — також у Vercel, Production і Preview):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Лише скрипти (обходить RLS!): npm run users:demo і npm run users:pm. Ніколи з префіксом NEXT_PUBLIC_.
# У Vercel не додаємо ніколи:
SUPABASE_SECRET_KEY=sb_secret_...

# Один пароль для всіх синтетичних користувачів npm run users:demo (≥ 8 символів):
DEMO_USER_PASSWORD=
# Пароль акаунтів PM (supabase/pm-users.json, npm run users:pm): окремий від демо-акаунтів, PM отримує його лише в чаті.
PM_USER_PASSWORD=

# Для Supabase MCP у Claude Code (.mcp.json читає змінну з оточення, а не з цього файлу):
# задайте її в терміналі перед запуском claude, напр. export SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PROJECT_REF=


# AI-функція (зріз 4, ADR 0008). Ключ Claude API: https://console.anthropic.com/settings/keys
# Лише сервер: у .env.local і у Vercel (лише Production: Preview не витрачає платні виклики на кожен PR). Ніколи з префіксом NEXT_PUBLIC_
# (такі значення потрапляють у браузер), ніколи в git, логах чи чаті. Читає ключ лише src/lib/ai/anthropic.ts.
# Виклики платні (Claude Haiku 5.5): на проді ліміт витрат задайте в консолі Anthropic.
ANTHROPIC_API_KEY=

# Назва середовища для /api/health і Sentry ("staging" лише на staging; порожня чи відсутня — не задано, Sentry бере VERCEL_ENV). Лише сервер.
APP_ENV=

# Sentry (лише серверні помилки). DSN не секрет, але в код не вбудований: без нього Sentry вимкнений (локально, CI).
# SENTRY_TRACES_SAMPLE_RATE і SENTRY_TRACE_LIFECYCLE не задавати: SDK читає їх із середовища й увімкнув би трасування з URL і шляхами.
# Задайте у Vercel (Production і Preview). SENTRY_AUTH_TOKEN (вивантаження source maps) — лише у Vercel і в .env.sentry-build-plugin (він у .gitignore), ніколи в GitHub чи git.
SENTRY_DSN=
